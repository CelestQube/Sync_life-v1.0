# Keep .env private; setup_local.py creates random database and Django secrets.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=sync_life_dev
POSTGRES_USER=sync_life
POSTGRES_PASSWORD=replace-locally
DJANGO_SECRET_KEY=replace-locally
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

AGENT_PROVIDER=bailian
AGENT_MODEL=qwen3.8-flash
# Beijing pay-as-you-go API; replace with a matching region/workspace base URL if needed.
AGENT_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
AGENT_MODEL_TIMEOUT=45
# Optional, required only for real nearby restaurant queries.
TENCENT_MAP_KEY=
# Optional: Tencent SecretKey, only when SN verification is enabled.
TENCENT_MAP_SECRET_KEY=
